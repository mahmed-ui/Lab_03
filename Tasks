#include <stdio.h>

int main(){
    int DistanceInKm;
    printf("Enter distance in kilometers: ");
    scanf("%d", &DistanceInKm);
    printf("Distance in meters: %d \n", 1000 * DistanceInKm);
    printf("Distance in centimeters: %ld \n", 100000L * DistanceInKm);
    return 0;
}

